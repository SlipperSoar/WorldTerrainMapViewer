/* === MainUI.uss — Dark glassmorphism theme === */

/* ── Root ── */
#root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
}

/* ── Slide Panel (left side) ── */
#slide-panel {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 340px;
    background-color: rgba(15, 18, 28, 0.92);
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.08);
    padding: 12px;
    overflow: hidden;
}

.panel-header {
    font-size: 16px;
    color: #4ECDC4;
    margin-bottom: 8px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
    letter-spacing: 1px;
}

.section-label {
    color: #888;
    font-size: 12px;
    margin-bottom: 4px;
}

/* ── Map List ── */
#map-list {
    margin-bottom: 12px;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 60px;
    overflow: scroll;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 6px;
    padding: 4px;
}

.map-item {
    background-color: rgba(30, 35, 50, 0.9);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 8px 10px;
    margin-bottom: 4px;
    color: #E8E8E8;
    font-size: 14px;
}

.map-item:hover {
    background-color: rgba(78, 205, 196, 0.15);
    border-color: rgba(78, 205, 196, 0.4);
}

.map-item:active {
    background-color: rgba(78, 205, 196, 0.3);
}

#map-file-name {
    color: #888;
    font-size: 12px;
    margin-bottom: 8px;
}

/* ── World Gen Section ── */
#worldgen-section {
    margin-top: 12px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
}

#seed-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

#seed-input {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.3);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    color: #E8E8E8;
    padding: 4px 8px;
    font-size: 14px;
    margin-right: 4px;
}

#seed-input > .unity-text-field__input {
    color: #080808;
    font-size: 14px;
}

#seed-input:focus {
    border-color: #4ECDC4;
}

#seed-input:focus > .unity-text-field__input {
    color: #080808;
}

#seed-random-btn {
    background-color: rgba(30, 35, 50, 0.9);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    color: #4ECDC4;
    padding: 4px 10px;
    font-size: 12px;
}

#seed-random-btn:hover {
    background-color: rgba(78, 205, 196, 0.15);
}

#water-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

#water-row > Label {
    color: #888;
    font-size: 12px;
    width: 60px;
}

#water-slider {
    flex-grow: 1;
    margin-right: 4px;
}

#water-value {
    color: #4ECDC4;
    font-size: 12px;
    width: 36px;
    -unity-text-align: middle-right;
}

#generate-button {
    background-color: rgba(78, 205, 196, 0.3);
    border-width: 1px;
    border-color: #4ECDC4;
    border-radius: 6px;
    color: #4ECDC4;
    font-size: 14px;
    padding: 8px;
}

#generate-button:hover {
    background-color: rgba(78, 205, 196, 0.15);
}

#generate-button:active {
    background-color: #4ECDC4;
    color: white;
}

#gen-progress-label {
    color: #888;
    font-size: 12px;
    margin-top: 4px;
    -unity-text-align: middle-center;
}

/* ── Marker List ── */
#marker-list-section {
    flex-grow: 2;
    flex-shrink: 1;
    min-height: 0;
    margin-top: 12px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
}

#marker-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 40px;
    overflow: scroll;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 6px;
    padding: 4px;
}

.marker-item {
    flex-direction: row;
    align-items: center;
    background-color: rgba(30, 35, 50, 0.9);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 4px 8px;
    margin-bottom: 3px;
}

.marker-item > Label {
    color: #E8E8E8;
    font-size: 12px;
    flex-grow: 1;
}

.marker-index-label {
    color: #4ECDC4;
    font-size: 12px;
    flex-shrink: 0;
    margin-right: 4px;
    -unity-font-style: bold;
}

.marker-name-field {
    flex-grow: 1;
    flex-shrink: 1;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0px;
    border-radius: 4px;
    color: #000000;
    font-size: 12px;
    padding: 1px 4px;
    margin-right: 4px;
    min-width: 0;
}

.marker-name-field > .unity-text-field__input {
    color: #000000;
    font-size: 12px;
}

.marker-name-field:focus {
    background-color: rgba(255, 255, 255, 0.85);
    border-width: 1px;
    border-color: rgba(78, 205, 196, 0.5);
}

.marker-name-field:focus > .unity-text-field__input {
    color: #000000;
}

.marker-color-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    margin-right: 8px;
    flex-shrink: 0;
}

.marker-delete-btn {
    background-color: rgba(231, 76, 60, 0.15);
    border-width: 1px;
    border-color: rgba(231, 76, 60, 0.3);
    border-radius: 4px;
    color: #E74C3C;
    font-size: 11px;
    padding: 2px 8px;
    flex-shrink: 0;
    flex-grow: 0;
}

.marker-delete-btn:hover {
    background-color: rgba(231, 76, 60, 0.3);
}

/* ── Top Bar ── */
#top-bar {
    flex-shrink: 0;
    flex-wrap: wrap;
    flex-direction: row;
    align-items: center;
    background-color: rgba(15, 18, 28, 0.92);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 6px 12px;
}

.top-section {
    flex-direction: row;
    align-items: center;
    margin-right: 8px;
}

.top-section > Label {
    color: #888;
    font-size: 12px;
    margin-right: 6px;
}

#time-slider {
    width: 140px;
}

#season-slider {
    width: 100px;
}

.slider-value {
    color: #4ECDC4;
    font-size: 12px;
    margin-left: 4px;
    min-width: 40px;
    -unity-text-align: middle-right;
}

#autocycle-toggle, #arrow-toggle, #plate-overlay-toggle {
    margin-right: 16px;
    margin-left: 4px;
    flex-shrink: 0;
}

.unity-toggle__label {
    color: white;
    font-size: 12px;
    white-space: nowrap;
}

/* ── Right Bar ── */
#right-bar {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 140px;
    background-color: rgba(15, 18, 28, 0.92);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 8px;
}

#exit-button {
    background-color: rgba(231, 76, 60, 0.15);
    border-width: 1px;
    border-color: rgba(231, 76, 60, 0.4);
    border-radius: 6px;
    color: #E74C3C;
    font-size: 14px;
    padding: 6px;
    margin-bottom: 8px;
}

#exit-button:hover {
    background-color: rgba(231, 76, 60, 0.3);
}

#exit-button:active {
    background-color: #E74C3C;
    color: white;
}

.view-button {
    background-color: rgba(30, 35, 50, 0.9);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    color: #E8E8E8;
    font-size: 14px;
    padding: 6px;
    margin-bottom: 4px;
}

.view-button:hover {
    background-color: rgba(78, 205, 196, 0.15);
    border-color: rgba(78, 205, 196, 0.4);
}

.view-button:active {
    background-color: rgba(78, 205, 196, 0.3);
}

/* ── Status Panel ── */
#status-panel {
    margin-top: 8px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
}

.status-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
}

.status-label {
    color: #888;
    font-size: 12px;
}

.status-value {
    color: #4ECDC4;
    font-size: 12px;
}

/* ── Bottom Bar ── */
#bottom-bar {
    flex-shrink: 0;
    flex-wrap: wrap;
    flex-direction: row;
    align-items: center;
    background-color: rgba(15, 18, 28, 0.92);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 6px 10px;
}

#color-palette {
    flex-direction: row;
    margin-right: 16px;
}

.color-button {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    margin-right: 3px;
}

.color-button:hover {
    border-color: rgba(255, 255, 255, 0.5);
}

.color-button--selected {
    border-color: #4ECDC4;
}

.color-number {
    color: white;
    font-size: 11px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

#current-color-label {
    color: #888;
    font-size: 12px;
    margin-right: 6px;
    white-space: nowrap;
}

#current-color-swatch {
    width: 24px;
    height: 24px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    margin-right: 12px;
    flex-shrink: 0;
}

#clear-markers-button {
    background-color: rgba(30, 35, 50, 0.9);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    color: #888;
    font-size: 12px;
    padding: 4px 10px;
    flex-shrink: 0;
    white-space: nowrap;
}

#clear-markers-button:hover {
    background-color: rgba(78, 205, 196, 0.15);
    color: #E8E8E8;
}

.draw-button {
    background-color: rgba(30, 35, 50, 0.9);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    color: #888;
    font-size: 12px;
    padding: 4px 10px;
    flex-shrink: 0;
    white-space: nowrap;
    margin-left: 4px;
}

.draw-button:hover {
    background-color: rgba(78, 205, 196, 0.15);
    color: #E8E8E8;
}

/* ── Hover Zone ── */
#hover-zone {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 20px;
    background-color: rgba(0, 0, 0, 0);
}

.hover-arrow {
    position: absolute;
    left: 4px;
    top: 50%;
    margin-top: -24px;
    width: 12px;
    height: 48px;
    background-color: rgba(78, 205, 196, 0.6);
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s, left 0.2s;
}

.hover-arrow-tip {
    width: 0;
    height: 0;
    border-top-width: 5px;
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-width: 5px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-left-width: 6px;
    border-left-style: solid;
    border-left-color: white;
}

#hover-zone:hover .hover-arrow {
    background-color: rgba(78, 205, 196, 0.9);
    left: 6px;
}

/* ── Slider overrides ── */
Slider {
    margin-top: 2px;
    margin-bottom: 2px;
}

/* ── Empty state text ── */
.empty-text {
    color: #888;
    font-size: 12px;
    padding: 12px;
    -unity-text-align: middle-center;
}
