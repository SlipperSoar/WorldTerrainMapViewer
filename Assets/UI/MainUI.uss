/* === MainUI.uss — Dark glassmorphism theme === */

/* ── Root ── */
#root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
}

/* ── Slide Panel (left side) ── */
#slide-panel {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 340px;
    background-color: rgba(15, 18, 28, 0.92);
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.08);
    padding: 12px;
    overflow: hidden;
}

.panel-header {
    font-size: 16px;
    color: #4ECDC4;
    margin-bottom: 8px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
    letter-spacing: 1px;
}

.section-label {
    color: #888;
    font-size: 12px;
    margin-bottom: 4px;
}

/* ── Map List ── */
#map-list {
    margin-bottom: 12px;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 60px;
    overflow: scroll;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 6px;
    padding: 4px;
}

.map-item {
    background-color: rgba(30, 35, 50, 0.9);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 8px 10px;
    margin-bottom: 4px;
    color: #E8E8E8;
    font-size: 14px;
}

.map-item:hover {
    background-color: rgba(78, 205, 196, 0.15);
    border-color: rgba(78, 205, 196, 0.4);
}

.map-item:active {
    background-color: rgba(78, 205, 196, 0.3);
}

#map-file-name {
    color: #888;
    font-size: 12px;
    margin-bottom: 8px;
}

/* ── World Gen Section ── */
#worldgen-section {
    margin-top: 12px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
}

#seed-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

#seed-input {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.3);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    color: #E8E8E8;
    padding: 4px 8px;
    font-size: 14px;
    margin-right: 4px;
}

#seed-input > .unity-text-field__input {
    color: #080808;
    font-size: 14px;
}

#seed-input:focus {
    border-color: #4ECDC4;
}

#seed-input:focus > .unity-text-field__input {
    color: #080808;
}

#seed-random-btn {
    background-color: rgba(30, 35, 50, 0.9);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    color: #4ECDC4;
    padding: 4px 10px;
    font-size: 12px;
}

#seed-random-btn:hover {
    background-color: rgba(78, 205, 196, 0.15);
}

#water-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

#water-row > Label {
    color: #888;
    font-size: 12px;
    width: 60px;
}

#water-slider {
    flex-grow: 1;
    margin-right: 4px;
}

#water-value {
    color: #4ECDC4;
    font-size: 12px;
    width: 40px;
    -unity-text-align: middle-right;
}

/* ── 地轴倾角（地图属性）── */
#tilt-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

#tilt-row > Label {
    color: #888;
    font-size: 12px;
    width: 60px;
}

#tilt-slider {
    flex-grow: 1;
    margin-right: 4px;
}

#tilt-value {
    color: #4ECDC4;
    font-size: 12px;
    width: 40px;
    -unity-text-align: middle-right;
}

/* ── 生成分辨率 ── */
#resolution-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

#resolution-row > Label {
    color: #888;
    font-size: 12px;
    width: 60px;
}

#resolution-slider {
    flex-grow: 1;
    margin-right: 4px;
}

#resolution-value {
    color: #4ECDC4;
    font-size: 12px;
    width: 76px;
    -unity-text-align: middle-right;
}

/* 内存估算提示：默认低调；占用可能过大时由代码加上 .resolution-hint-warn */
#resolution-hint {
    color: #666;
    font-size: 11px;
    margin-bottom: 8px;
    padding-left: 60px;
}

#resolution-hint.resolution-hint-warn {
    color: #E8A33D;
}

/* ── 星球大小 / 自转方向 ── */
#planet-size-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

#planet-size-row > Label {
    color: #888;
    font-size: 12px;
    width: 60px;
}

#planet-size-slider {
    flex-grow: 1;
    margin-right: 4px;
}

#planet-size-value {
    color: #4ECDC4;
    font-size: 12px;
    width: 76px;
    -unity-text-align: middle-right;
}

#rotation-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

#rotation-row > Label {
    color: #888;
    font-size: 12px;
    width: 60px;
}

#generate-button {
    background-color: rgba(78, 205, 196, 0.3);
    border-width: 1px;
    border-color: #4ECDC4;
    border-radius: 6px;
    color: #4ECDC4;
    font-size: 14px;
    padding: 8px;
}

#generate-button:hover {
    background-color: rgba(78, 205, 196, 0.15);
}

#generate-button:active {
    background-color: #4ECDC4;
    color: white;
}

#gen-progress-label {
    color: #888;
    font-size: 12px;
    margin-top: 4px;
    -unity-text-align: middle-center;
}

/* ── Marker List ── */
#marker-list-section {
    flex-grow: 2;
    flex-shrink: 1;
    min-height: 0;
    margin-top: 12px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
}

#marker-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 40px;
    overflow: scroll;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 6px;
    padding: 4px;
}

.marker-item {
    flex-direction: row;
    align-items: center;
    background-color: rgba(30, 35, 50, 0.9);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 4px 8px;
    margin-bottom: 3px;
}

.marker-item > Label {
    color: #E8E8E8;
    font-size: 12px;
    flex-grow: 1;
}

.marker-index-label {
    color: #4ECDC4;
    font-size: 12px;
    flex-shrink: 0;
    margin-right: 4px;
    -unity-font-style: bold;
}

.marker-name-field {
    flex-grow: 1;
    flex-shrink: 1;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0px;
    border-radius: 4px;
    color: #000000;
    font-size: 12px;
    padding: 1px 4px;
    margin-right: 4px;
    min-width: 0;
}

.marker-name-field > .unity-text-field__input {
    color: #000000;
    font-size: 12px;
}

.marker-name-field:focus {
    background-color: rgba(255, 255, 255, 0.85);
    border-width: 1px;
    border-color: rgba(78, 205, 196, 0.5);
}

.marker-name-field:focus > .unity-text-field__input {
    color: #000000;
}

.marker-color-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    margin-right: 8px;
    flex-shrink: 0;
}

.marker-delete-btn {
    background-color: rgba(231, 76, 60, 0.15);
    border-width: 1px;
    border-color: rgba(231, 76, 60, 0.3);
    border-radius: 4px;
    color: #E74C3C;
    font-size: 11px;
    padding: 2px 8px;
    flex-shrink: 0;
    flex-grow: 0;
}

.marker-delete-btn:hover {
    background-color: rgba(231, 76, 60, 0.3);
}

/* ── Top Bar ── */
#top-bar {
    flex-shrink: 0;
    /* 不换行：原来 flex-wrap: wrap 会在宽度不够时换行，把栏体撑高从而压到右侧栏上。
       空间不足时宁可横向溢出，也不要把栏撑高。 */
    flex-wrap: nowrap;
    flex-direction: row;
    align-items: center;
    background-color: rgba(15, 18, 28, 0.92);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 5px 10px;
    /* 右侧给固定的右栏（140 + 8 + 8 = 156px）让位，避免重叠；左侧只做少量留白 */
    margin-right: 164px;
    margin-left: 8px;
}

.top-section {
    flex-direction: row;
    align-items: center;
    margin-right: 8px;
}

.top-section > Label {
    color: #888;
    font-size: 12px;
    margin-right: 6px;
}

#time-slider {
    width: 140px;
}

#season-slider {
    width: 100px;
}

.slider-value {
    color: #4ECDC4;
    font-size: 12px;
    margin-left: 4px;
    min-width: 40px;
    -unity-text-align: middle-right;
}

#autocycle-toggle, #arrow-toggle, #plate-overlay-toggle,
#terrain-displacement-toggle, #cloud-layer-toggle, #human-overlay-toggle {
    margin-right: 2px;
    margin-left: 0;
    padding-left: 0;
    padding-right: 0;
    flex-shrink: 0;
}

/* ── 开关（Toggle）紧凑化 ──
   实测结构（Tuanjie 2022.3，由 UIController.ReportToggleLayout 打印）：
     Toggle
       [0] Label          class=unity-base-field__label,unity-toggle__label   默认宽 150px（文字只占约 23px）
       [1] VisualElement  class=unity-base-field__input,unity-toggle__input   **默认宽 0**
             [1.0] VisualElement name="unity-checkmark"                      24×24，被父级 0 宽裁掉 → 看不见

   所以「看不见勾选框」与「文字和勾选框之间一片空白」是同一个原因：
   输入区宽度为 0（勾选框被裁掉），而 label 的宽度被默认样式定死。

   ⚠ 注意选择器范围：**只能用 .unity-toggle__* 这类 Toggle 专属类名**。
   不要用 .unity-base-field__input / .unity-base-field__label —— 它们是基类，
   滑条（Slider）、输入框（TextField）的内部结构也用这些类，会被一起改坏
   （曾把「时间/流速/季节」滑条压成 24px 宽）。 */
.unity-toggle,
.unity-toggle__label,
.unity-toggle__checkmark,
.unity-base-toggle__checkmark {
    flex-grow: 0;
    padding-left: 0;
    padding-right: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

/* 输入区是勾选框的父级：宽度为 0 会把 24px 的勾选框裁掉，必须给够宽度。
   （精确到 Toggle 专属类名；基类会在代码里按实例设置，不影响滑条与输入框。） */
.unity-toggle__input {
    width: 24px;
    min-width: 24px;
    max-width: 24px;
    flex-grow: 0;
    flex-shrink: 0;
    padding-left: 0;
    padding-right: 0;
    margin-left: 4px;
    margin-right: 0;
}

/* 标签：默认样式把宽度定死了（实测 pl=0 pr=0 但 w 仍是 150px），
   必须显式放回「按内容自适应」，光去掉 padding 不够。 */
.unity-toggle__label {
    width: auto;
    min-width: 0;
    max-width: none;
    flex-basis: auto;
    flex-grow: 0;
    flex-shrink: 0;
    padding-left: 0;
    padding-right: 0;
    margin-left: 0;
    margin-right: 2px;
    color: white;
    font-size: 11px;
    white-space: nowrap;
}

/* ── Right Bar ── */
#right-bar {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 140px;
    background-color: rgba(15, 18, 28, 0.92);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 8px;
}

#exit-button {
    background-color: rgba(231, 76, 60, 0.15);
    border-width: 1px;
    border-color: rgba(231, 76, 60, 0.4);
    border-radius: 6px;
    color: #E74C3C;
    font-size: 14px;
    padding: 6px;
    margin-bottom: 8px;
}

#exit-button:hover {
    background-color: rgba(231, 76, 60, 0.3);
}

#exit-button:active {
    background-color: #E74C3C;
    color: white;
}

.view-button {
    background-color: rgba(30, 35, 50, 0.9);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    color: #E8E8E8;
    font-size: 14px;
    padding: 6px;
    margin-bottom: 4px;
}

.view-button:hover {
    background-color: rgba(78, 205, 196, 0.15);
    border-color: rgba(78, 205, 196, 0.4);
}

.view-button:active {
    background-color: rgba(78, 205, 196, 0.3);
}

/* ── Status Panel ── */
#status-panel {
    margin-top: 8px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
}

.status-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
}

.status-label {
    color: #888;
    font-size: 12px;
}

.status-value {
    color: #4ECDC4;
    font-size: 12px;
}

/* ── Bottom Bar ── */
#bottom-bar {
    flex-shrink: 0;
    flex-wrap: wrap;
    flex-direction: row;
    align-items: center;
    background-color: rgba(15, 18, 28, 0.92);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 6px 10px;
}

#color-palette {
    flex-direction: row;
    margin-right: 16px;
}

.color-button {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    margin-right: 3px;
}

.color-button:hover {
    border-color: rgba(255, 255, 255, 0.5);
}

.color-button--selected {
    border-color: #4ECDC4;
}

.color-number {
    color: white;
    font-size: 11px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

#current-color-label {
    color: #888;
    font-size: 12px;
    margin-right: 6px;
    white-space: nowrap;
}

#current-color-swatch {
    width: 24px;
    height: 24px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    margin-right: 12px;
    flex-shrink: 0;
}

#clear-markers-button {
    background-color: rgba(30, 35, 50, 0.9);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    color: #888;
    font-size: 12px;
    padding: 4px 10px;
    flex-shrink: 0;
    white-space: nowrap;
}

#clear-markers-button:hover {
    background-color: rgba(78, 205, 196, 0.15);
    color: #E8E8E8;
}

.draw-button {
    background-color: rgba(30, 35, 50, 0.9);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    color: #888;
    font-size: 12px;
    padding: 4px 10px;
    flex-shrink: 0;
    white-space: nowrap;
    margin-left: 4px;
}

.draw-button:hover {
    background-color: rgba(78, 205, 196, 0.15);
    color: #E8E8E8;
}

/* ── Hover Zone ── */
#hover-zone {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 20px;
    background-color: rgba(0, 0, 0, 0);
}

.hover-arrow {
    position: absolute;
    left: 4px;
    top: 50%;
    margin-top: -24px;
    width: 12px;
    height: 48px;
    background-color: rgba(78, 205, 196, 0.6);
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s, left 0.2s;
}

.hover-arrow-tip {
    width: 0;
    height: 0;
    border-top-width: 5px;
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-width: 5px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-left-width: 6px;
    border-left-style: solid;
    border-left-color: white;
}

#hover-zone:hover .hover-arrow {
    background-color: rgba(78, 205, 196, 0.9);
    left: 6px;
}

/* ── Slider overrides ── */
Slider {
    margin-top: 2px;
    margin-bottom: 2px;
}

/* ── Empty state text ── */
.empty-text {
    color: #888;
    font-size: 12px;
    padding: 12px;
    -unity-text-align: middle-center;
}
